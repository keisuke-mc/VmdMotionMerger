<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VmdMotionMerger.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VmdMotionMerger.Models">

    <Grid x:Name="RootGrid"
          Padding="16"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" MinHeight="100" />
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Grid.Row="0"
                   Text="VMD Motion Merger"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <!-- ツールバー -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="VMDを追加"
                    Command="{x:Bind ViewModel.AddFilesCommand}" />
            <Button Content="削除"
                    Command="{x:Bind ViewModel.RemoveSelectedCommand}" />
            <Button Content="すべて削除"
                    Command="{x:Bind ViewModel.ClearAllCommand}" />
            <Button Content="上へ"
                    Command="{x:Bind ViewModel.MoveUpCommand}" />
            <Button Content="下へ"
                    Command="{x:Bind ViewModel.MoveDownCommand}" />
        </StackPanel>

        <!-- ファイルリスト -->
        <Border Grid.Row="2"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,0,0,12">
            <ListView x:Name="FileListView"
                      ItemsSource="{x:Bind ViewModel.Items}"
                      SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:LoadedVmdItem">
                        <StackPanel Orientation="Vertical" Padding="4,6">
                            <TextBlock Text="{x:Bind DisplayLabel, Mode=OneWay}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind SummaryText, Mode=OneWay}"
                                       FontSize="12"
                                       Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- ドラッグ＆ドロップ案内 -->
        <TextBlock Grid.Row="3"
                   Text="※ ウィンドウへVMDファイルをドラッグ＆ドロップして追加することもできます（複数可）"
                   FontSize="12"
                   Opacity="0.6"
                   Margin="0,0,0,8" />

        <!-- 結合開始 -->
        <Button Grid.Row="4"
                Content="結合開始"
                HorizontalAlignment="Stretch"
                Style="{StaticResource AccentButtonStyle}"
                Margin="0,0,0,12"
                Command="{x:Bind ViewModel.MergeCommand}" />

        <!-- 出力先 -->
        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="出力先：" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1"
                      Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay}"
                      PlaceholderText="combined.vmd の保存先を指定してください" />
            <Button Grid.Column="2"
                    Content="参照"
                    Margin="8,0,0,0"
                    Command="{x:Bind ViewModel.BrowseOutputCommand}" />
        </Grid>

        <!-- ステータス -->
        <StackPanel Grid.Row="6" Spacing="4" Margin="0,0,0,8">
            <TextBlock Text="ステータス" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
            <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                         Minimum="0" Maximum="100" />
        </StackPanel>

        <!-- ログ -->
        <Border Grid.Row="7"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <ListView x:Name="LogListView"
                      ItemsSource="{x:Bind ViewModel.LogEntries}"
                      SelectionMode="None"
                      FontFamily="Consolas">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" FontSize="12" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Window>
